import logging
import random
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes

logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)

TOKEN = "8981045477:AAHCiu01fynQ0mkwCTS_W4wlnIZfawdlzLM"
ADMIN_ID = 8552447077

# ذخیره سکه (فقط برای خودت)
user_data = {}

def get_user(user_id):
    if user_id not in user_data:
        user_data[user_id] = {'balance': 0}
    return user_data[user_id]

# ======== دستور start ========
async def start(update, context):
    keyboard = [[InlineKeyboardButton("🎲 پرتاب تاس", callback_data='dice')]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("سلام! دکمه رو بزن تا تاس بندازم:", reply_markup=reply_markup)

# ======== بازی تاس ========
async def dice(update, context):
    num = random.randint(1, 6)
    emojis = {1:'⚀',2:'⚁',3:'⚂',4:'⚃',5:'⚄',6:'⚅'}
    await update.callback_query.message.edit_text(f"🎲 {emojis[num]}  عدد {num}")
    await update.callback_query.answer()

# ======== دستور setcoin (فقط برای خودت) ========
async def set_coin(update, context):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("❌ فقط ادمین!")
        return
    try:
        amount = int(context.args[0])
        user_id = update.effective_user.id
        get_user(user_id)['balance'] = amount
        await update.message.reply_text(f"✅ موجودی تنظیم شد: {amount}")
    except:
        await update.message.reply_text("❌ دستور: /setcoin 50000")

# ======== اصلی ========
def main():
    app = Application.builder().token(TOKEN).build()
    
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("setcoin", set_coin))
    app.add_handler(CallbackQueryHandler(dice, pattern='dice'))
    
    print("✅ ربات روشن شد! برو تلگرام و /start رو بزن.")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
